+
+/// splitmix64: a tiny deterministic RNG that is easy to mirror in Python.
+struct Mix(u64);
+
+impl Mix {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+}
+
+const SMART_DRAWS: usize = 8;
+
+fn card_key(c: &kernel::Card) -> (u8, u8, u8, u8, bool, bool) {
+    (c.rank, c.suit, c.enh, c.edition, c.red, c.debuff)
+}
