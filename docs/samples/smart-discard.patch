+fn best_struct(scorer: &kernel::Scorer, infos: &[kernel::Card]) -> f64 {
+    let mut best = 0.0f64;
+    for mut combo in candidates(infos) {
+        combo.sort_unstable();
+        combo.dedup();
+        let cs: Vec<kernel::Card> = combo.iter().map(|&p| infos[p]).collect();
+        let (name, sc) = kernel::classify(&cs);
+        let s = scorer.score(infos, &combo, name, &sc);
+        if s > best {
+            best = s;
+        }
+    }
+    best
 }
 
