+    /// JEV_SMART_DISCARD: the hold (cards kept) whose redraws score best on average. Holds: the
+    /// heuristic's, each suit with 3+ cards, all rank groups, the best 5-rank straight window, and the
+    /// best structural play's cards. Each tosses up to 5 of the rest (debuffed, then lowest, first) and
+    /// is scored over SMART_DRAWS redraws from the canonically sorted draw pile (splitmix64, seeded by
+    /// the hand), with the jokers' text scorer.
+    fn smart_discard(&self, g: &GameState, scorer: &kernel::Scorer, infos: &[kernel::Card], forced: &[usize]) -> Vec<usize> {
+        let n = infos.len();
+        let live: Vec<usize> = (0..n).filter(|&p| !infos[p].debuff).collect();
+        let base = discard(infos, forced);
+        let mut holds: Vec<Vec<usize>> = vec![(0..n).filter(|p| !base.contains(p)).collect()];
+        for s in 1..=4u8 {
+            let h: Vec<usize> = live.iter().copied()
+                .filter(|&p| infos[p].enh != kernel::STONE && (infos[p].suit == s || infos[p].enh == kernel::WILD)).collect();
+            if h.len() >= 3 {
+                holds.push(h);
+            }
+        }
+        let mut counts: HashMap<u8, usize> = HashMap::new();
+        for &p in &live {
+            if infos[p].rank != 0 && infos[p].enh != kernel::STONE {
+                *counts.entry(infos[p].rank).or_insert(0) += 1;
+            }
+        }
+        let groups: Vec<usize> = live.iter().copied()
+            .filter(|&p| infos[p].rank != 0 && infos[p].enh != kernel::STONE && counts[&infos[p].rank] >= 2).collect();
+        if !groups.is_empty() {
+            holds.push(groups);
+        }
+        // straight window: the 5-rank window holding the most distinct ranks (ties: the higher window)
+        let mut best_w: Option<Vec<usize>> = None;
+        for lo in 1..=10u8 {
+            let ranks: Vec<u8> = (lo..lo + 5).map(|r| if r == 1 { 14 } else { r }).collect();
+            let mut w: Vec<usize> = Vec::new();
+            for r in ranks {
+                if let Some(&p) = live.iter().find(|&&p| infos[p].rank == r && infos[p].enh != kernel::STONE) {
+                    w.push(p);
+                }
+            }
+            if w.len() >= 3 && best_w.as_ref().map_or(true, |b| w.len() >= b.len()) {
+                best_w = Some(w);
+            }
+        }
+        if let Some(w) = best_w {
+            holds.push(w);
+        }
+        let mut best_play: (f64, Vec<usize>) = (-1.0, vec![]);
+        for mut combo in candidates(infos) {
+            combo.sort_unstable();
+            combo.dedup();
+            let cs: Vec<kernel::Card> = combo.iter().map(|&p| infos[p]).collect();
+            let (name, sc) = kernel::classify(&cs);
+            let s = scorer.score(infos, &combo, name, &sc);
+            if s > best_play.0 {
+                best_play = (s, combo);
+            }
+        }
+        holds.push(best_play.1);
+
+        let mut pool: Vec<kernel::Card> = g.draw_pile.iter().map(info).collect();
+        pool.sort_by_key(card_key);
+        let mut seed: u64 = 0x5EED;
+        for c in infos {
+            let k = card_key(c);
+            seed = seed.wrapping_mul(1_000_003).wrapping_add(((k.0 as u64) << 8) | k.1 as u64);
+        }
+        let mut best: Option<(f64, Vec<usize>)> = None;
+        let mut seen: Vec<Vec<usize>> = Vec::new();
+        for hold in holds {
+            let mut toss: Vec<usize> = (0..n).filter(|p| !hold.contains(p)).collect();
+            toss.sort_by_key(|&p| (!infos[p].debuff, rv(&infos[p])));
+            toss.truncate(5);
+            for &f in forced {
+                if !toss.contains(&f) {
+                    toss.truncate(4);
+                    toss.push(f);
+                }
+            }
+            let mut key = toss.clone();
+            key.sort_unstable();
+            if toss.is_empty() || seen.contains(&key) {
+                continue;
+            }
+            seen.push(key);
+            let kept: Vec<kernel::Card> = (0..n).filter(|p| !toss.contains(p)).map(|p| infos[p]).collect();
+            let k = toss.len().min(pool.len());
+            let mut rng = Mix(seed);
+            let mut total = 0.0;
+            for _ in 0..SMART_DRAWS {
+                let mut idx: Vec<usize> = (0..pool.len()).collect();
+                let mut hand = kept.clone();
+                for j in 0..k {
+                    let t = j + rng.below(idx.len() - j);
+                    idx.swap(j, t);
+                    hand.push(pool[idx[j]]);
+                }
+                total += best_struct(scorer, &hand);
+            }
+            if best.as_ref().map_or(true, |b| total > b.0) {
+                best = Some((total, toss));
+            }
+        }
+        best.map(|b| b.1).unwrap_or(base)
+    }
